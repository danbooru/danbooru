#!/usr/bin/env ruby

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require_relative "../lib/media_file"

# Like `ls` or `exiftool`, but for listing properties of media files. See lib/media_file/cli.rb for the implementation.
#
# Usage: `bin/media-ls [options] [FILE|DIR ...]`
exit MediaFile::CLI.run!(*ARGV)
