#!/usr/bin/env bash
#
# Install a coding agent CLI. Safe to run multiple times.
#
# Usage:
#   bin/setup-agent claude   # Claude Code (installs `claude`)
#   bin/setup-agent gemini   # Google Antigravity CLI (installs `agy`)

set -euo pipefail

usage() {
  echo "Usage: $0 <claude|gemini>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage

case "$1" in
  claude)
    binary="claude"
    installer="https://claude.ai/install.sh"
    ;;
  gemini)
    binary="agy"
    installer="https://antigravity.google/cli/install.sh"
    ;;
  *)
    usage
    ;;
esac

# A script can't change its parent shell's PATH, so the current shell won't find the new command.
[[ ":$PATH:" == *":$HOME/.local/bin:"* ]] && path_ok=true || path_ok=false
export PATH="$HOME/.local/bin:$PATH"

if ! grep -qs '\.local/bin' "$HOME/.bashrc"; then
  echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
  echo "Added ~/.local/bin to PATH in ~/.bashrc"
fi

if command -v "$binary" > /dev/null 2>&1; then
  echo "$binary is already installed: $(command -v "$binary")"
  exit 0
fi

echo "Installing $binary from $installer..."
curl -fsSL "$installer" | bash

if ! command -v "$binary" > /dev/null 2>&1; then
  echo "Error: $binary was not found after installing." >&2
  exit 1
fi

echo "Installed $binary: $(command -v "$binary")"
$path_ok || echo "Run \`exec bash\` or open a new terminal to use $binary."
