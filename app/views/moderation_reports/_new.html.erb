<div class="report-dialog-body">
  <%= embed_wiki("help:report_notice") %>

  <%= edit_form_for(moderation_report, format: :js, remote: true) do |f| %>
    <%= f.hidden_field :model_type %>
    <%= f.hidden_field :model_id %>
    <%= f.input :reason, hint: tag.span("Ctrl+Enter to submit", class: "desktop-only"), as: :dtext, inline: true, input_html: { autofocus: true } %>
    <div class="dialog-buttons">
      <%= f.submit_button "Report" %>
      <%= f.cancel_button if local_assigns[:inline] %>
    </div>
  <% end %>
</div>
