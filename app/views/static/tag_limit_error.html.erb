<% page_title "Search Error" %>

<h1>Search Error</h1>

<p>
  <%= @message %>

  <% if CurrentUser.is_anonymous? %>
    <%= link_to "Sign up", new_user_path %> to search for more tags at once.
  <% elsif !CurrentUser.is_gold? %>
    <%= link_to "Upgrade your account", new_user_upgrade_path  %> to search for more tags at once.
  <% end %>
</p>

<%= link_to "Go back", :back, rel: "prev" %>
