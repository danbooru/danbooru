<?xml version="1.0" encoding="UTF-8"?>

<% max_id = @relation.maximum(:id).to_i %>
<% page_count = max_id / @limit + 1 %>
<% id_ranges = page_count.times.map { |page| [page * @limit, (page + 1) * @limit] } %>

<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <% id_ranges.each do |lo, hi| %>
    <% if @sitemap == "posts" %>
      <% loc = posts_url(limit: @limit, format: :sitemap, tags: "id:#{lo}..#{hi}") %>
    <% else %>
      <% loc = polymorphic_url(@relation.klass, limit: @limit, format: :sitemap, search: { id: "#{lo}..#{hi}", **@search }) %>
    <% end %>

    <sitemap>
      <loc><%= loc %></loc>
    </sitemap>
  <% end %>
</sitemapindex>
