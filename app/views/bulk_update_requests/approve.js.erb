<% if @bulk_update_request.errors.any? %>
  Danbooru.Notice.error("<%= j format_text(@bulk_update_request.errors.full_messages.join("; "), inline: true) %>");
<% else %>
  if ($("#a-index").length) {
    $("#request-status-for-<%= @bulk_update_request.id %>").html("queued");
  } else {
    location.reload();
  }
<% end %>
