<% page_title "Reset Password" %>

<div id="c-password-resets">
  <div id="a-edit">
    <div class="card mt-8 p-4 max-w-480px mx-auto flex flex-col items-center">
      <h1 class="pb-4">Reset Password</h1>

      <% if @user.has_2fa? %>
        <p class="w-full">
          <% if @user.totp.present? %>
            Enter the 6-digit code from your authenticator app to change your password.
          <% else %>
            Enter a backup code to change your password.
          <% end %>
        </p>
      <% end %>

      <%= edit_form_for(@user, url: password_reset_path, method: "put", html: { class: "w-full stacked-form stacked-hints", "data-validate-form": "true" }) do |f| %>
        <%= f.input :signed_id, as: :hidden, input_html: { value: params.dig(:user, :signed_id) }  %>

        <% if @user.has_2fa? %>
          <%= f.input :verification_code, placeholder: @user.totp.present? ? "123456" : "12345678", required: true, minlength: 6, maxlength: User::BACKUP_CODE_LENGTH, pattern: '\d+', input_html: { value: nil }, hint: @user.totp.present? ? "Lost your phone? You can enter a backup code instead." : nil %>
        <% end %>

        <%= f.input :password, required: true, label: "New password", input_html: { autocomplete: "new-password", minlength: User::MIN_PASSWORD_LENGTH } %>
        <%= f.input :password_confirmation, required: true, label: "Confirm password", input_html: { autocomplete: "new-password" } %>
        <p class="text-sm text-muted">Resetting your password will log you out on all other devices.</p>
        <%= f.submit_button "Save" %>
      <% end %>
    </div>
  </div>
</div>

<%= render "sessions/secondary_links" %>
