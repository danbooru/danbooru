<% page_title "Confirm password" %>
<%= render "secondary_links" %>

<div id="c-sessions">
  <div id="a-confirm-password">
    <div class="card mt-8 p-4 max-w-480px mx-auto flex flex-col items-center">
      <h1 class="pb-4">Confirm Password</h1>

      <% if @passkeys.present? %>
        <p class="w-full">Use your passkey to continue.</p>

        <button
          type="button"
          class="button-primary w-full"
          data-passkey-reauthenticate="true"
          data-options-url="<%= reauthenticate_passkey_options_session_path %>"
          data-verify-url="<%= reauthenticate_passkey_session_path %>"
          data-url="<%= @url %>"
        >Use a passkey</button>

        <div class="text-error fineprint mt-2" data-passkey-error></div>
      <% end %>

      <% if @passkeys.present? %>
        <div class="w-full text-center fineprint my-4">or</div>
      <% end %>

      <% if @user.totp.present? %>
        <p class="w-full">Enter your password and the 6-digit code from your authenticator app to continue.</p>
      <% elsif @user.backup_codes.present? %>
        <p class="w-full">Enter your password and a backup code to continue.</p>
      <% else %>
        <p class="w-full">Enter your password to continue.</p>
      <% end %>

      <%= edit_form_for(@session, as: :session, url: reauthenticate_session_path, method: "post", html: { class: "w-full stacked-form stacked-hints", "data-validate-form": true }) do |f| %>
        <%= f.input :url, as: :hidden, input_html: { value: @url } %>
        <%= f.input :password, hint: link_to("Forgot password?", password_reset_path), require: true, input_html: { autofocus: true, autocomplete: "current-password", value: nil } %>
        <% if @user.totp.present? || @user.backup_codes.present? %>
          <%= f.input :verification_code, placeholder: @user.totp.present? ? "123456" : "12345678", required: true, minlength: 6, maxlength: User::BACKUP_CODE_LENGTH, pattern: '\d+', input_html: { value: nil }, hint: @user.totp.present? ? "Lost your phone? You can enter a backup code instead." : nil %>
        <% end %>
        <%= f.submit_button "Continue" %>
      <% end %>

      <% if flash[:alert].present? %>
        <p class="text-error mt-4"><%= flash[:alert] %></p>
      <% end %>
    </div>
  </div>
</div>

<%= render "sessions/passkey_script" %>
