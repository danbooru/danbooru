<%= edit_form_for(forum_post) do |f| %>
  <% if forum_post.topic_id.present? %>
    <%= f.input :topic_id, :as => :hidden %>
  <% else %>
    <%= f.input :topic_id, :label => "Topic ID" %>
  <% end %>

  <%= f.input :body, as: :dtext, editor_html: { class: "dtext-editor-large" } %>

  <%= f.submit_button "Post" %>
  <%= f.cancel_button if local_assigns[:inline] %>
<% end %>
