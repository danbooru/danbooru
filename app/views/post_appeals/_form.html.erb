<div class="appeal-dialog-body">
  <%= embed_wiki("help:appeal_notice", classes: "mb-4") %>

  <% if CurrentUser.user.post_appeals.pending.count > 0 %>
    <p><b>Remaining appeals</b>: <%= CurrentUser.user.upload_limit.remaining_appeals %></p>
  <% end %>

  <%= edit_form_for(post_appeal, format: :js, remote: true) do |f| %>
    <%= f.hidden_field :post_id if post_appeal.new_record? %>
    <%= f.input :reason, hint: tag.span("Ctrl+Enter to submit", class: "desktop-only"), as: :dtext, inline: true, placeholder: "Briefly explain why the post should be undeleted (optional)", input_html: { autofocus: true } %>
    <div class="dialog-buttons">
      <%= f.submit_button create: "Appeal" %>
      <%= f.cancel_button if local_assigns[:inline] %>
    </div>
  <% end %>
</div>
