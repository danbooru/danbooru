<% if api_key.new_record? %>
  <p>Your API key will be shown once after you create it. Save it somewhere safe.</p>
<% end %>

<%= edit_form_for(api_key, html: { class: "stacked-hints" }, formatted_errors: true) do |f| %>
  <%= f.input :name, as: :string, hint: "An optional name to help you remember what this key is for." %>

  <% if api_key.new_record? %>
    <div x-data="{ expires: <%= api_key.expires? %> }">
      <%= f.input :expires, as: :boolean, label: "Expires", input_html: { checked: api_key.expires?, "x-model": "expires" }, hint: "Check to set an expiration date. Leave unchecked to make the key permanent." %>
      <div x-show="expires">
        <%= f.input :expires_on, as: :date, html5: true, include_blank: false, input_html: { "x-bind:disabled": "!expires" }, hint: "The key will stop working at the end of this day. Defaults to one year from now." %>
      </div>
    </div>
  <% else %>
    <div class="input">
      <label>Expires</label>
      <div><%= api_key.expires_at ? api_key.expires_at.to_date.to_fs(:long) : "Never" %></div>
    </div>
  <% end %>

  <%= f.input :permitted_ip_addresses, label: "IP Addresses", as: :string, hint: "An optional list of IPs allowed to use this key. Space separated, subnets allowed. Leave blank to allow all IPs." %>
  <%= f.input :permissions, as: :select, collection: ApiKey.permissions_list, hint: "An optional list of API endpoints this key is allowed to use. Ctrl+click to select multiple endpoints. Leave blank to allow all API endpoints.", input_html: { multiple: true } %>
  <%= f.submit_button %>
<% end %>
